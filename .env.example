# ---------------------------------------------------------------------------
# PlateVision configuration (copy to .env)
# ---------------------------------------------------------------------------

# --- app -------------------------------------------------------------------
APP_NAME=PlateVision
ENVIRONMENT=development          # development | staging | production | test
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false              # set true behind HTTPS in production
ALLOW_DEMO_LOGIN=true

# --- data ------------------------------------------------------------------
# SQLite (default, zero-ops) or Postgres in production (psycopg is bundled):
# DATABASE_URL=postgresql+psycopg://platevision:secret@localhost:5432/platevision
DATABASE_URL=sqlite:///./storage/platevision.db
STORAGE_BACKEND=local            # local | s3  (s3 needs requirements-s3.txt)
STORAGE_DIR=./storage/uploads
MODEL_CACHE_DIR=./storage/models
# S3_BUCKET=platevision-captures
# S3_REGION=ap-south-1
# S3_ENDPOINT_URL=https://s3.amazonaws.com   # MinIO / R2 / B2

# --- recognition -----------------------------------------------------------
ALPR_DEFAULT_COUNTRY=IN
ALPR_COUNTRIES=IN,US,UK,EU,GENERIC
ALPR_MAX_IMAGE_DIM=1800
ALPR_MAX_CANDIDATES=6
ALPR_MIN_CONFIDENCE=0.42
ALPR_REVIEW_CONFIDENCE=0.72
ALPR_DUPLICATE_WINDOW_SECONDS=90

# --- optional remote reader -------------------------------------------------
# The local OpenCV pipeline is the default and needs no credentials, so these
# can stay unset and the app deploys and works. Set ALPR_ENGINE=parkpow to send
# reads to Plate Recognizer's hosted API instead (paid key required); if the key
# is missing or a call fails, the local engine answers automatically.
#
# The parkpow/deep-license-plate-recognition repository is a *client* for this
# API -- it ships no model weights. See docs/remote-reader.md.
ALPR_ENGINE=local                # local | parkpow
PARKPOW_API_KEY=                 # leave empty to stay entirely local
PARKPOW_BASE_URL=https://api.platerecognizer.com
PARKPOW_TIMEOUT_SECONDS=8
PARKPOW_REGIONS=                 # e.g. in  (comma separated, sent as -r)
PARKPOW_CAMERA_ID=
PARKPOW_RETRIES=2

# --- http ------------------------------------------------------------------
MAX_UPLOAD_MB=12
CORS_ORIGINS=*                   # restrict to your console origin in production
ALLOWED_HOSTS=*                  # e.g. plates.example.com (validates Host header)
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_BURST=60
TRUST_PROXY_HEADERS=true

# --- boot ------------------------------------------------------------------
# Schema is created by the container entrypoint before workers start; demo
# seeding and the glyph-bank build then run on a background thread once the port
# is bound, so neither can delay a deploy. SEED_DEMO_DATA controls the seeding
# half only. (BOOTSTRAP_ON_START is accepted for compatibility and is not read.)
BOOTSTRAP_ON_START=true

# --- demo ------------------------------------------------------------------
SEED_DEMO_DATA=true
DEMO_EMAIL=elara@platevision.io
DEMO_PASSWORD=nightwatch
